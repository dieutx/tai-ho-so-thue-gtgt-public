# Cấu hình mẫu cho framework.
# Sao chép file này thành .env rồi chỉnh theo nhu cầu.
# File .env đã nằm trong .gitignore, không bao giờ bị đẩy lên git.

# --- Khoảng thời gian thu thập (dd/mm/yyyy) ---
# Có thể dài hơn window_days; chương trình tự chia thành nhiều khoảng.
TAXDOC_FROM_DATE=01/01/2026
TAXDOC_TO_DATE=31/01/2026
TAXDOC_OUTPUT_DIR=output/demo

# --- Nguồn tài liệu ---
# Bản public chỉ hỗ trợ "mock": chạy hoàn toàn offline, sinh dữ liệu tất định.
TAXDOC_PROVIDER=mock

# --- Tài khoản ---
# Provider mock không cần tài khoản. Với một nguồn thật, điền mã tài khoản ở đây.
# Khoá tài khoản không bao giờ bị ghi thẳng ra log (xem RedactionFilter).
# TAXDOC_ACCOUNT_ID=example-account
# TAXDOC_ACCOUNT_KEY=example-value

# --- Quy tắc chia khoảng ---
# Số ngày tối đa mỗi khoảng tra cứu.
TAXDOC_WINDOW_DAYS=31
# Số tài liệu mỗi trang.
TAXDOC_PAGE_SIZE=10

# --- Nguồn mock sinh bao nhiêu tài liệu (chỉ dùng cho demo/test) ---
TAXDOC_MOCK_RECORDS=6

# --- Độ kiên nhẫn và thử lại ---
TAXDOC_REQUEST_ATTEMPTS=3
TAXDOC_RETRY_BACKOFF=1.5
TAXDOC_PAUSE_BETWEEN_PAGES=0

# --- Chỉ liệt kê, không ghi tài liệu ---
# TAXDOC_DRY_RUN=false

# --- Log ---
# Ghi thêm toàn bộ log ở mức DEBUG ra file. Giá trị nhạy cảm được che bằng ***.
# TAXDOC_LOG_FILE=logs/run.log
TAXDOC_LOG_LEVEL=INFO
